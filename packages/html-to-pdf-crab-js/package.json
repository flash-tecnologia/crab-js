{
  "name": "html-to-pdf-crab-js",
  "version": "0.4.0",
  "keywords": [
    "N-API",
    "Rust",
    "html",
    "html-to-pdf",
    "napi",
    "napi-rs",
    "node-addon",
    "node-addon-api",
    "pdf"
  ],
  "homepage": "https://github.com/flash-tecnologia/crab-js",
  "license": "MIT",
  "author": "inaiat@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flash-tecnologia/crab-js.git",
    "directory": "packages/html-to-pdf-crab-js"
  },
  "files": [
    "browser.js",
    "browser-threaded.js",
    "index.d.ts",
    "index.d.cts",
    "index.js",
    "*.wasi-browser.js",
    "*.wasi.cjs",
    "*.wasi.d.cts",
    "wasi-worker*.mjs",
    "*.wasip1-browser.js",
    "*.wasip1.cjs",
    "*.wasip1.d.cts",
    "*.wasip1-deferred.js",
    "*.wasip1-deferred.d.ts",
    "html-to-pdf-crab-js.wasm32-wasi.wasm",
    "html-to-pdf-crab-js.wasm32-wasip1.wasm"
  ],
  "type": "module",
  "main": "index.js",
  "browser": "./browser.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./browser": {
      "types": "./index.d.ts",
      "default": "./browser.js"
    },
    "./browser.js": {
      "types": "./index.d.ts",
      "default": "./browser.js"
    },
    "./browser/threaded": {
      "types": "./index.d.ts",
      "default": "./browser-threaded.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "check": "vp check",
    "build": "node build.mjs",
    "build:debug": "node build.mjs --debug",
    "build:wasm": "node build.mjs --target wasm32-wasip1",
    "build:wasm-threaded": "node build.mjs --target wasm32-wasip1-threads",
    "example": "pnpm --dir ../.. --filter html-to-pdf-crab-js-examples invoice",
    "example:browser": "pnpm --dir ../.. --filter html-to-pdf-crab-js-examples browser",
    "example:invoice": "pnpm --dir ../.. --filter html-to-pdf-crab-js-examples invoice",
    "example:report": "pnpm --dir ../.. --filter html-to-pdf-crab-js-examples report",
    "example:wasm": "pnpm --dir ../.. --filter html-to-pdf-crab-js-examples wasm:browser",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "vp test run js-tests/unit",
    "test:wasm": "pnpm run build:wasm && NAPI_RS_WASI_FLAVOR=wasm32-wasip1 node js-tests/wasm-smoke.mjs",
    "test:wasm-threaded": "pnpm run build:wasm-threaded && NAPI_RS_WASI_FLAVOR=wasm32-wasi node js-tests/wasm-smoke.mjs",
    "test:workerd": "pnpm run build:wasm && node js-tests/workerd-smoke.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "catalog:",
    "@emnapi/runtime": "catalog:",
    "@napi-rs/cli": "catalog:",
    "@napi-rs/wasm-runtime": "catalog:",
    "emnapi": "catalog:"
  },
  "napi": {
    "binaryName": "html-to-pdf-crab-js",
    "rootPublisher": "npm",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-musl",
      "wasm32-wasip1",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "optionalDependency": false
    }
  },
  "engines": {
    "node": "24"
  }
}
